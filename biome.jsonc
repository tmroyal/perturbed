// Lint and format for the repo's JavaScript: npm run lint (check), npm run format (fix).
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["surface/*.js", "surface/icon/*.js", "tools/**/*.js", "tests/*.js", "*.json", "surface/*.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  // The renderer scripts (surface/*.js but main, preload, osc) share globals through <script> tags;
  // Biome checks files one by one, so its unused-variable check is off for them.
  "overrides": [
    {
      "includes": ["surface/*.js", "!surface/main.js", "!surface/preload.js", "!surface/osc.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
